#!/usr/bin/env bash
# dk-watch — start, stop or auto-start the agent dashboard (http://127.0.0.1:4777).
# Usage: dk-watch [start|stop|restart|status|logs|autostart|no-autostart]
set -euo pipefail
SERVER="@DK_TEAM@/tools/dk-watch/server.mjs"
PORT="${DK_WATCH_PORT:-4777}"
URL="http://127.0.0.1:$PORT"
DIR="$HOME/.dk-watch"; mkdir -p "$DIR"
PIDF="$DIR/server.pid"; LOG="$DIR/server.log"
PLIST="$HOME/Library/LaunchAgents/io.dkteam.dk-watch.plist"
running() { curl -fs -o /dev/null --max-time 1 "$URL/events?since=999999999"; }
start() {
  if running; then echo "dk-watch is already running → $URL"
  else
    [ -f "$SERVER" ] || { echo "Missing $SERVER — run: dk-team install."; exit 1; }
    nohup node "$SERVER" --port "$PORT" >>"$LOG" 2>&1 &
    echo $! > "$PIDF"
    for _ in $(seq 1 25); do running && break; sleep 0.2; done
    running && echo "dk-watch started → $URL" || { echo "dk-watch did not start; see $LOG"; exit 1; }
  fi
  if [ "${1:-}" != "--no-open" ]; then
    if command -v open >/dev/null 2>&1; then open "$URL" || true
    elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$URL" >/dev/null 2>&1 || true
    else echo "Open $URL in your browser"; fi
  fi
}
stop() {
  if [ -f "$PIDF" ] && kill "$(cat "$PIDF")" 2>/dev/null; then rm -f "$PIDF"; echo "dk-watch stopped"
  elif pkill -f "dk-watch/server.mjs" 2>/dev/null; then echo "dk-watch stopped"
  else echo "dk-watch is not running"; fi
}
case "${1:-start}" in
  start)   start "${2:-}" ;;
  stop)    stop ;;
  restart) stop; sleep 0.5; start "${2:-}" ;;
  status)  running && echo "running → $URL" || echo "not running" ;;
  logs)    touch "$LOG"; tail -n 50 -f "$LOG" ;;
  autostart)
    NODE="$(command -v node)"
    if ! command -v launchctl >/dev/null 2>&1; then
      # Linux: systemd user service
      UNIT="$HOME/.config/systemd/user/dk-watch.service"; mkdir -p "$(dirname "$UNIT")"
      printf '[Unit]\nDescription=dk-watch agent dashboard\n\n[Service]\nExecStart=%s %s --port %s\nRestart=on-failure\n\n[Install]\nWantedBy=default.target\n' "$NODE" "$SERVER" "$PORT" > "$UNIT"
      stop >/dev/null 2>&1 || true
      systemctl --user daemon-reload && systemctl --user enable --now dk-watch.service
      echo "dk-watch will now start at login (systemd user service) → $URL"; exit 0
    fi
    mkdir -p "$(dirname "$PLIST")"
    cat > "$PLIST" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>io.dkteam.dk-watch</string>
  <key>ProgramArguments</key><array><string>$NODE</string><string>$SERVER</string><string>--port</string><string>$PORT</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict></plist>
PL
    stop >/dev/null 2>&1 || true
    launchctl bootout "gui/$(id -u)" "$PLIST" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$PLIST"
    echo "dk-watch will now start at login (and is starting now) → $URL" ;;
  no-autostart)
    if ! command -v launchctl >/dev/null 2>&1; then
      systemctl --user disable --now dk-watch.service 2>/dev/null || true
      rm -f "$HOME/.config/systemd/user/dk-watch.service"; echo "dk-watch auto-start removed"; exit 0
    fi
    launchctl bootout "gui/$(id -u)" "$PLIST" 2>/dev/null || true
    rm -f "$PLIST"; echo "dk-watch auto-start removed" ;;
  *) echo "Usage: dk-watch [start|stop|restart|status|logs|autostart|no-autostart]"; exit 2 ;;
esac
